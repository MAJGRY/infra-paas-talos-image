# What every node image contains (ADR 0003 in infra-paas-controlplane). Edited by hand.
#
# After changing TALOS_VERSION or EXTENSIONS, run hack/resolve.sh and commit image.lock with it.
# REVISION numbers the builds of one Talos version: bump it whenever image.lock or the build
# changes, reset it to 1 with a new TALOS_VERSION. A release is published once per
# ${TALOS_VERSION}-${REVISION} and never overwritten.

TALOS_VERSION=v1.14.5
REVISION=1

# Official Talos system extensions, by name (ghcr.io/siderolabs/<name>):
#   gvisor            runsc runtime for the gvisor RuntimeClass (ADR 0007)
#   iscsi-tools       Longhorn v1 data engine (ADR 0006)
#   util-linux-tools  Longhorn (nsenter, fstrim, ...)
#   tailscale         admin network and Talos API access over the tailnet (ADR 0010)
EXTENSIONS="gvisor iscsi-tools tailscale util-linux-tools"
